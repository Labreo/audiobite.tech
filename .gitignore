# Environment variables & secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.tox/
.nox/

# Type checking & Linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# Audio working files & temporary media
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac
!app/static/audio/*.wav
tmp/
temp/
exports/*.pdf
!exports/.gitkeep

# ML Model weights & checkpoints (downloaded at runtime or via Ollama)
*.pt
*.bin
*.safetensors
*.onnx
models/*
!models/.gitkeep

# Package builds & distribution
build/
dist/
*.egg-info/
.eggs/

# Node / Frontend (if tooling added)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System & IDE
.DS_Store
.DS_Store?
._*
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Logs & runtime artifacts
*.log
logs/
