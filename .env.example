# ==============================================================================
# AudioBite.tech / StemNote - Environment Variables Template
# Hacktoberfest 2026 Week 2 ("Side Hustle") — Zero-Burn $0.00 Stack
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & APP SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
AI_RUNTIME_MODE=cloud        # 'cloud' (Google AI Studio / OpenRouter Gemma 4 31B) or 'local' (Ollama)
CUSTOM_TECH_DOMAIN=audiobite.tech

# ------------------------------------------------------------------------------
# 2. OPEN-WEIGHT GEMMA 4 31B CLOUD INFERENCE ($0.00 / No Credit Card Required)
# ------------------------------------------------------------------------------
# Primary Route: Google AI Studio Free Tier (aistudio.google.com)
GEMINI_API_KEY=
GEMMA_CLOUD_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai
GEMMA_CLOUD_MODEL=gemma-4-31b-it

# Secondary Route: OpenRouter Free Tier (openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ------------------------------------------------------------------------------
# 3. SENTRY AGENT TRACING (Free Developer Tier, $0.00)
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 4. TABPFN-V2 FOUNDATION MODEL (Runs 100% In-Container on CPU, $0.00)
# ------------------------------------------------------------------------------
TABPFN_API_KEY=
TABPFN_MODE=local            # 'local' runs CPU TabPFN-v2 on 88 sessions; zero third-party calls

# ------------------------------------------------------------------------------
# 5. LOCAL OFFLINE OLLAMA MODE (100% Private Desk Companion, $0.00)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=gemma2:2b

# ------------------------------------------------------------------------------
# 6. MONETIZATION & SIDE HUSTLE TELEMETRY ($4.99 Studio Supporter)
# ------------------------------------------------------------------------------
CHECKOUT_OR_WAITLIST_URL=https://www.buymeacoffee.com/kakeroth
ENABLE_MICRO_CHECKOUT=true
