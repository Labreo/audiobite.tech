# ==============================================================================
# AudioBite.tech / StemNote - Environment Variables Template
# Hacktoberfest 2026 Week 2 ("Side Hustle")
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & APP SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
AI_RUNTIME_MODE=cloud        # 'cloud' (DigitalOcean Serverless Gemma) or 'local' (Ollama Gemma)
CUSTOM_TECH_DOMAIN=audiobite.tech

# ------------------------------------------------------------------------------
# 2. DIGITALOCEAN SERVERLESS INFERENCE (Best Use of DigitalOcean & Gemma)
# ------------------------------------------------------------------------------
# Model endpoint: https://inference.do-ai.run/v1 or custom DO Serverless URL
DO_INFERENCE_API_KEY=
DO_MODEL_ENDPOINT=https://inference.do-ai.run/v1
DO_MODEL_ID=google-gemma-4-31b-it

# ------------------------------------------------------------------------------
# 3. SENTRY AGENT TRACING (Best Use of Sentry Agent Tracing)
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 4. TABPFN-V2 (Best Use of TabPFN)
# ------------------------------------------------------------------------------
TABPFN_API_KEY=
TABPFN_TOKEN=
TABPFN_MODE=local            # 'local' runs CPU TabPFN-v2 with n_estimators=4; 'cloud' uses Prior Labs API

# ------------------------------------------------------------------------------
# 5. LOCAL OFFLINE MODE (BYO-Ollama Pro Mode)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=gemma2:2b

# ------------------------------------------------------------------------------
# 6. MONETIZATION & CONVERSION TELEMETRY ($4.99 Side Hustle Pro)
# ------------------------------------------------------------------------------
CHECKOUT_OR_WAITLIST_URL=https://audiobite.tech/#unlock-pro
ENABLE_MICRO_CHECKOUT=true
